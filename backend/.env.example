OPENAI_API_KEY=
PORT=4000
# Optional: override the default full-meal analysis model (gpt-4o-mini is much faster than
# gpt-4o and accurate enough for nutrient estimation; switch to gpt-4o only if quality suffers)
# OPENAI_MODEL=gpt-4o-mini
# Optional: override the default quick food-identification model (used by the camera's
# "Scan Food" flow — pick something cheap/fast since it only names the food, not nutrients)
# OPENAI_VISION_MODEL=gpt-4o-mini
